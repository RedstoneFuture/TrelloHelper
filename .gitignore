# ============================================================
# Java / Maven Project - .gitignore
# Version 1.1
# ============================================================

# ------------------------------------------------------------
# Maven
# ------------------------------------------------------------

# Maven build output (including multi-module projects)
target/

# Maven release and versioning files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
buildNumber.properties

# Maven Shade Plugin generated POM
dependency-reduced-pom.xml

# Maven build timing information
.mvn/timing.properties

# ------------------------------------------------------------
# Java
# ------------------------------------------------------------

# Compiled Java classes
*.class

# Compiled Java archives
# Also ignores the optional Maven Wrapper JAR.
*.jar
*.war
*.ear

# Uncomment to include the Maven Wrapper JAR in version control
# !.mvn/wrapper/maven-wrapper.jar

# Java virtual machine crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------
# IntelliJ IDEA
# ------------------------------------------------------------

# IntelliJ project configuration
.idea/

# IntelliJ module and project files
*.iml
*.ipr
*.iws

# IntelliJ compiler output
out/

# ------------------------------------------------------------
# Eclipse
# ------------------------------------------------------------

# Eclipse project configuration
.project
.classpath
.settings/

# Eclipse compiler output
bin/

# ------------------------------------------------------------
# NetBeans
# ------------------------------------------------------------

# NetBeans private project configuration
/nbproject/private/

# NetBeans build output
/build/
/nbbuild/
/dist/
/nbdist/

# ------------------------------------------------------------
# Visual Studio Code
# ------------------------------------------------------------

# Uncomment to ignore local VS Code workspace settings
# .vscode/
# *.code-workspace

# ------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# ------------------------------------------------------------
# Logs and Debugging
# ------------------------------------------------------------

# Log files and directories
*.log
logs/

# Debug and diagnostic output
*.dump
*.trace

# ------------------------------------------------------------
# Temporary Files and Backups
# ------------------------------------------------------------

# Temporary and editor files
*.tmp
*.temp
*.swp
*.swo

# Backup and patch files
*.bak
*.old
*.orig
*.rej
*~

# ------------------------------------------------------------
# Environment and Secrets
# ------------------------------------------------------------

# Environment variable files
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ------------------------------------------------------------
# End of .gitignore
# ============================================================