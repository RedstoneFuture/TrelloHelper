{
  "manifest_version": 2,
  "name": "TrelloHelper",
  "version": "0.1.0",
  "description": "Opens Trello links in the desktop app instead of a web browser window.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://trello.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "trello-helper@rauh-solutions.de",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}